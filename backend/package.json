{
  "name": "centralize-emails-backend",
  "version": "1.0.0",
  "description": "Backend pour centraliser les emails Leboncoin depuis Google Sheets",
  "main": "src/server.js",
  "bin": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "npx pkg . --targets node18-win-x64 --output dist/LBC-Automation.exe"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.5.0",
    "google-spreadsheet": "^4.1.1",
    "imap": "^0.8.19",
    "mailparser": "^3.6.5",
    "puppeteer": "^24.15.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "src/**/*",
      ".env",
      "node_modules/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  }
}
